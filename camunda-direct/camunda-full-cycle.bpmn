<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="helios-full-cycle-defs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="helios-camunda-full-cycle" name="HELIOS — Camunda seul : detecte par SSH, decide via IA, execute par SSH" isExecutable="true">

    <!-- =============== 1. CAMUNDA DECLENCHE =============== -->
    <bpmn:startEvent id="Timer" name="Cycle 60s">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td1">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT60S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Timer" targetRef="Detecter" />

    <!-- =============== 2. DETECTION — SSH SUR LA VM MONITORING ===============
         Camunda se connecte en SSH sur .160 ; le detecteur y interroge Prometheus,
         Loki et Grafana EN LOCAL et rend UN incident deja classe parmi 16 types,
         avec sa cible. Le type vient du motif kubelet : c'est une VERITE TERRAIN,
         pas une supposition. Toutes les regles rendent zero sur un cluster sain.
    -->
    <bpmn:serviceTask id="Detecter" name="1. DETECTER (SSH sur la VM monitoring .160)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://127.0.0.1:8099/detecter" target="url" />
          <zeebe:input source="=60" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34;, &#34;X-Helios-Token&#34;: &#34;{{secrets.HELIOS_BRIDGE_TOKEN}}&#34; }" target="headers" />
          <zeebe:input source="={ source: &#34;camunda&#34; }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="={ typeDetecte: response.body.type, ns: response.body.ns, cible: response.body.cible, noeudCible: response.body.noeud, nbAnomalies: response.body.nbAnomalies, monitoringFiable: response.body.monitoringFiable, preuve: response.body.preuve, severite: response.body.severite }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="Detecter" targetRef="Decision" />

    <!-- =============== 3. Y A-T-IL DE QUOI DECIDER ? =============== -->
    <bpmn:exclusiveGateway id="Decision" name="Anomalie et monitoring fiable ?" default="fSain">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>fAno</bpmn:outgoing>
      <bpmn:outgoing>fSain</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="fAno" name="oui" sourceRef="Decision" targetRef="IA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nbAnomalies &gt; 0 and monitoringFiable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fSain" name="non" sourceRef="Decision" targetRef="FinSain" />

    <!-- =============== 4. L'IA DECIDE L'ACTION =============== -->
    <bpmn:serviceTask id="IA" name="2. IA (.161:8000) - quelle action ?">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://192.168.148.161:8000/predict" target="url" />
          <zeebe:input source="=60" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34; }" target="headers" />
          <zeebe:input source="={ namespace: ns, app: cible, windowMinutes: 5 }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="={ actionIA: response.body.recommended_action, typeIA: response.body.incident_type, confianceIA: response.body.confidence }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fAno</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="IA" targetRef="Routage" />

    <!-- =============== 5. PEUT-ON EXECUTER ? =============== -->
    <bpmn:exclusiveGateway id="Routage" name="Peut-on executer l'action de l'IA ?" default="fExec">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>fProtege</bpmn:outgoing>
      <bpmn:outgoing>fRien</bpmn:outgoing>
      <bpmn:outgoing>fIncoherent</bpmn:outgoing>
      <bpmn:outgoing>fExec</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Garde-fou 1 : namespaces systeme. Camunda est admin par SSH ; une erreur de
         diagnostic redemarrerait CoreDNS ou l'operateur de base. On detecte, on trace,
         on n'agit pas. -->
    <bpmn:sequenceFlow id="fProtege" name="namespace systeme : escalade" sourceRef="Routage" targetRef="FinProtege">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=list contains(["kube-system","kube-public","kube-node-lease","cnpg-system","calico-system","tigera-operator","falco","local-path-storage","monitoring"], ns)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fRien" name="IA: aucun incident" sourceRef="Routage" targetRef="FinSain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=typeIA = "NO_INCIDENT" or actionIA = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Garde-fou 2 : le type MESURE sur le cluster contredit le diagnostic de l'IA.
         Mesure : sur un blocage DNS reel le modele repond POD_IMAGE_PULL_BACKOFF a
         0.7188 de confiance. DEPLOYMENT_UNAVAILABLE est exclu : c'est un symptome
         generique que l'IA a le droit d'affiner. -->
    <bpmn:sequenceFlow id="fIncoherent" name="diagnostic IA contredit par le cluster" sourceRef="Routage" targetRef="FinIncoherent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=typeIA != typeDetecte and typeDetecte != "DEPLOYMENT_UNAVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fExec" name="executer (SSH, aucune limite RBAC)" sourceRef="Routage" targetRef="ExecuterSSH" />

    <!-- =============== 6. EXECUTION — SSH, AUCUNE LIMITE RBAC ===============
         La passerelle traduit l'action de l'IA en commande reelle :
         kubectl sur le MASTER (kubeconfig admin), systemctl sur le NOEUD,
         ou vmrun via le watchdog hote si la VM est ETEINTE.
    -->
    <bpmn:serviceTask id="ExecuterSSH" name="3. EXECUTER l'action de l'IA (SSH)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://127.0.0.1:8099/action" target="url" />
          <zeebe:input source="=110" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34;, &#34;X-Helios-Token&#34;: &#34;{{secrets.HELIOS_BRIDGE_TOKEN}}&#34; }" target="headers" />
          <zeebe:input source="={ action: actionIA, ns: ns, cible: cible, noeud: cible }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="={ execOk: response.body.ok, execCode: response.body.exitCode, execCmd: response.body.command, execResume: response.body.resume, execFait: response.body.execute }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fExec</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f4" sourceRef="ExecuterSSH" targetRef="Tracer" />

    <!-- =============== 7. TRACER LA VERITE =============== -->
    <bpmn:serviceTask id="Tracer" name="4. Tracer la decision et le RESULTAT REEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://127.0.0.1:8099/trace" target="url" />
          <zeebe:input source="=60" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34;, &#34;X-Helios-Token&#34;: &#34;{{secrets.HELIOS_BRIDGE_TOKEN}}&#34; }" target="headers" />
          <zeebe:input source="={ ns: ns, cible: cible, action: actionIA, type: typeIA, origine: typeDetecte, resultat: execResume, ok: execOk }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={ traceOk: response.body.ok }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f5" sourceRef="Tracer" targetRef="FinExec" />

    <bpmn:endEvent id="FinExec" name="Action IA executee par Camunda">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FinSain" name="Cluster sain">
      <bpmn:incoming>fSain</bpmn:incoming>
      <bpmn:incoming>fRien</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FinProtege" name="Namespace systeme : escalade, AUCUNE action">
      <bpmn:incoming>fProtege</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FinIncoherent" name="Diagnostic IA contredit par le cluster : escalade">
      <bpmn:incoming>fIncoherent</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="P1" bpmnElement="helios-camunda-full-cycle">
      <bpmndi:BPMNShape id="s1" bpmnElement="Timer"><dc:Bounds x="140" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2" bpmnElement="Detecter"><dc:Bounds x="230" y="220" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s3" bpmnElement="Decision" isMarkerVisible="true"><dc:Bounds x="450" y="235" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s4" bpmnElement="IA"><dc:Bounds x="550" y="220" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s5" bpmnElement="Routage" isMarkerVisible="true"><dc:Bounds x="750" y="235" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s6" bpmnElement="ExecuterSSH"><dc:Bounds x="850" y="220" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s7" bpmnElement="Tracer"><dc:Bounds x="1060" y="220" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s8" bpmnElement="FinExec"><dc:Bounds x="1270" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s9" bpmnElement="FinSain"><dc:Bounds x="457" y="400" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s10" bpmnElement="FinProtege"><dc:Bounds x="757" y="400" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s11" bpmnElement="FinIncoherent"><dc:Bounds x="757" y="480" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e1" bpmnElement="f1"><di:waypoint x="176" y="260" /><di:waypoint x="230" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e2" bpmnElement="f2"><di:waypoint x="400" y="260" /><di:waypoint x="450" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e3" bpmnElement="fAno"><di:waypoint x="500" y="260" /><di:waypoint x="550" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e4" bpmnElement="fSain"><di:waypoint x="475" y="285" /><di:waypoint x="475" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e5" bpmnElement="f3"><di:waypoint x="700" y="260" /><di:waypoint x="750" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e6" bpmnElement="fExec"><di:waypoint x="800" y="260" /><di:waypoint x="850" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e7" bpmnElement="fProtege"><di:waypoint x="775" y="285" /><di:waypoint x="775" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e8" bpmnElement="fIncoherent"><di:waypoint x="775" y="285" /><di:waypoint x="720" y="480" /><di:waypoint x="757" y="498" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e9" bpmnElement="fRien"><di:waypoint x="760" y="270" /><di:waypoint x="600" y="400" /><di:waypoint x="493" y="418" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e10" bpmnElement="f4"><di:waypoint x="1010" y="260" /><di:waypoint x="1060" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e11" bpmnElement="f5"><di:waypoint x="1220" y="260" /><di:waypoint x="1270" y="260" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
