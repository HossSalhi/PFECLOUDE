<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="helios-full-cycle-defs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="helios-camunda-full-cycle" name="HELIOS — Camunda seul : detecte, decide via IA, execute" isExecutable="true">

    <!-- =============== 1. CAMUNDA DECLENCHE =============== -->
    <bpmn:startEvent id="Timer" name="Cycle 60s">
      <bpmn:outgoing>fT</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td1">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT60S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="fT" sourceRef="Timer" targetRef="Cpu" />

    <bpmn:serviceTask id="Cpu" name="1. PROMETHEUS - saturation CPU (initialise)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://192.168.148.160:9090/api/v1/query" target="url" />
          <zeebe:input source="=15" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ query: &#34;sum by (namespace,pod) (rate(container_cpu_usage_seconds_total{container!=\&#34;POD\&#34;,container!=\&#34;\&#34;}[3m])) &gt; 0.15&#34; }" target="queryParameters" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="=if count(response.body.data.result) &gt; 0 then { nbAnomalies: 1, origine: &#34;cpu&#34;, ns: response.body.data.result[1].metric.namespace, cible: string join(sublist(split(response.body.data.result[1].metric.pod, &#34;-&#34;), 1, count(split(response.body.data.result[1].metric.pod, &#34;-&#34;)) - 2), &#34;-&#34;) } else { nbAnomalies: 0, origine: &#34;aucune&#34;, ns: &#34;aucun&#34;, cible: &#34;aucun&#34; }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fT</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f1" sourceRef="Cpu" targetRef="Prometheus" />


    <!-- =============== 2. PROMETHEUS — TOUS LES NAMESPACES =============== -->
    <bpmn:serviceTask id="Prometheus" name="1. PROMETHEUS (.160) - tous namespaces">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://192.168.148.160:9090/api/v1/query" target="url" />
          <zeebe:input source="=15" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ query: &#34;kube_deployment_status_replicas_unavailable &gt; 0&#34; }" target="queryParameters" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="=if count(response.body.data.result) &gt; 0 then { nbAnomalies: 1, origine: &#34;replicas&#34;, cible: response.body.data.result[1].metric.deployment, ns: response.body.data.result[1].metric.namespace } else { }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="Prometheus" targetRef="Noeuds" />

    <!-- Detection au niveau des VMs. Placee en DERNIER des detecteurs : une VM tombee
         rend aussi des replicas indisponibles, et c'est la panne de VM qui prime. -->
    <bpmn:serviceTask id="Noeuds" name="1c. PROMETHEUS - une VM du cluster est-elle KO ?">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://192.168.148.160:9090/api/v1/query" target="url" />
          <zeebe:input source="=15" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ query: &#34;kube_node_status_condition{condition=\&#34;Ready\&#34;,status=\&#34;true\&#34;} == 0&#34; }" target="queryParameters" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="=if count(response.body.data.result) &gt; 0 then { nbAnomalies: 1, origine: &#34;noeud&#34;, cible: response.body.data.result[1].metric.node, ns: &#34;k8s-nodes&#34; } else { }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f2b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2b" sourceRef="Noeuds" targetRef="Loki" />


    <!-- =============== 3. LOKI =============== -->
    <bpmn:serviceTask id="Loki" name="2. LOKI (.160) - logs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://192.168.148.160:3100/loki/api/v1/query" target="url" />
          <zeebe:input source="=15" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ query: &#34;sum(count_over_time({job=\&#34;k8s-containers\&#34;} |~ \&#34;(?i)(error|exception|panic)\&#34; [5m]))&#34; }" target="queryParameters" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="={ nbErreursLogs: if count(response.body.data.result) &gt; 0 then number(response.body.data.result[1].value[2]) else 0 }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="Loki" targetRef="Grafana" />

    <!-- =============== 4. GRAFANA — fiabilite du stack =============== -->
    <bpmn:serviceTask id="Grafana" name="3. GRAFANA (.160) - sante du stack">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://192.168.148.160:3000/api/health" target="url" />
          <zeebe:input source="=10" target="connectionTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="={ monitoringFiable: response.body.database = &#34;ok&#34;, grafanaVersion: response.body.version }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f4" sourceRef="Grafana" targetRef="Decision" />

    <!-- =============== 5. DECISION =============== -->
    <bpmn:exclusiveGateway id="Decision" name="Anomalie ?" default="fSain">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>fAno</bpmn:outgoing>
      <bpmn:outgoing>fSain</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="fAno" name="oui" sourceRef="Decision" targetRef="IA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nbAnomalies &gt; 0 and monitoringFiable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fSain" name="non" sourceRef="Decision" targetRef="FinSain" />

    <!-- =============== 6. L'IA DECIDE L'ACTION =============== -->
    <bpmn:serviceTask id="IA" name="4. IA (.161:8000) - quelle action ?">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://192.168.148.161:8000/predict" target="url" />
          <zeebe:input source="=60" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34; }" target="headers" />
          <zeebe:input source="={ namespace: ns, app: cible, windowMinutes: 5 }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="={ actionIA: response.body.recommended_action, typeIA: response.body.incident_type, confianceIA: response.body.confidence }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fAno</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f5" sourceRef="IA" targetRef="Verifier" />

    <!-- Verification de la premisse : le cluster confirme-t-il le diagnostic de l'IA ?
         Le modele s'effondre sur la classe la plus frequente (mesure : un blocage DNS
         reel est diagnostique POD_IMAGE_PULL_BACKOFF a 0.7188). On ne remedie pas sur
         une premisse contredite par kubelet. -->
    <bpmn:serviceTask id="Verifier" name="4b. Le cluster confirme-t-il le diagnostic ?">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://192.168.148.160:9090/api/v1/query" target="url" />
          <zeebe:input source="=25" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ query: &#34;kube_pod_container_status_waiting_reason{namespace=\&#34;&#34; + ns + &#34;\&#34;,reason=~\&#34;ImagePullBackOff|ErrImagePull|InvalidImageName\&#34;} &gt; 0&#34; }" target="queryParameters" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={ imageConfirmee: count(response.body.data.result) &gt; 0 }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f5b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f5b" sourceRef="Verifier" targetRef="Routage" />

    <!-- =============== 7. ROUTAGE SELON L'ACTION DE L'IA =============== -->
    <bpmn:exclusiveGateway id="Routage" name="Quelle action l'IA demande-t-elle ?" default="fRestart">
      <bpmn:incoming>f5b</bpmn:incoming>
      <bpmn:outgoing>fProtege</bpmn:outgoing>
      <bpmn:outgoing>fNoeud</bpmn:outgoing>
      <bpmn:outgoing>fIncoherent</bpmn:outgoing>
      <bpmn:outgoing>fRien</bpmn:outgoing>
      <bpmn:outgoing>fNetpol</bpmn:outgoing>
      <bpmn:outgoing>fScale</bpmn:outgoing>
      <bpmn:outgoing>fRestart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="fProtege" name="namespace systeme : escalade humaine" sourceRef="Routage" targetRef="FinProtege">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=list contains(["kube-system","kube-public","kube-node-lease","cnpg-system","calico-system","tigera-operator","falco","local-path-storage","monitoring"], ns)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fNoeud" name="panne de VM : action niveau systeme" sourceRef="Routage" targetRef="ActionNoeud">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=origine = "noeud" and typeIA != "NO_INCIDENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fIncoherent" name="premisse contredite par le cluster" sourceRef="Routage" targetRef="FinIncoherent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(contains(actionIA, "IMAGE") or contains(actionIA, "PULLABLE")) and imageConfirmee = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fRien" name="IA: aucun incident" sourceRef="Routage" targetRef="FinSain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=typeIA = "NO_INCIDENT" or actionIA = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fNetpol" name="REMOVE_NETWORK_POLICY" sourceRef="Routage" targetRef="ListerNetpol">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=contains(actionIA, "NETWORK")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fScale" name="SCALE" sourceRef="Routage" targetRef="Scaler">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=contains(actionIA, "SCALE")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fRestart" name="ROLLBACK / RESTART (defaut)" sourceRef="Routage" targetRef="Redemarrer" />

    <!-- = Branche A : supprimer la NetworkPolicy bloquante = -->
    <bpmn:serviceTask id="ListerNetpol" name="5a. Lister les NetworkPolicies">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;https://192.168.148.150:6443/apis/networking.k8s.io/v1/namespaces/&#34; + ns + &#34;/networkpolicies&#34;" target="url" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Authorization&#34;: &#34;Bearer {{secrets.K8S_TOKEN}}&#34; }" target="headers" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="={ netpolNom: if count(response.body.items) &gt; 0 then response.body.items[1].metadata.name else &#34;aucune&#34; }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fNetpol</bpmn:incoming>
      <bpmn:outgoing>fa1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fa1" sourceRef="ListerNetpol" targetRef="SupprimerNetpol" />

    <bpmn:serviceTask id="SupprimerNetpol" name="5b. SUPPRIMER la NetworkPolicy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="DELETE" target="method" />
          <zeebe:input source="=&#34;https://192.168.148.150:6443/apis/networking.k8s.io/v1/namespaces/&#34; + ns + &#34;/networkpolicies/&#34; + netpolNom" target="url" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Authorization&#34;: &#34;Bearer {{secrets.K8S_TOKEN}}&#34; }" target="headers" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={ resultatExec: &#34;NetworkPolicy supprimee: &#34; + netpolNom, codeHttp: response.status }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fa1</bpmn:incoming>
      <bpmn:outgoing>fa2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fa2" sourceRef="SupprimerNetpol" targetRef="Tracer" />

    <!-- = Branche B : scaler = -->
    <bpmn:serviceTask id="Scaler" name="5c. SCALER le deploiement">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;https://192.168.148.150:6443/apis/apps/v1/namespaces/&#34; + ns + &#34;/deployments/&#34; + cibleEff + &#34;/scale&#34;" target="url" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Authorization&#34;: &#34;Bearer {{secrets.K8S_TOKEN}}&#34;, &#34;Content-Type&#34;: &#34;application/merge-patch+json&#34; }" target="headers" />
          <zeebe:input source="={ spec: { replicas: 2 } }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={ resultatExec: &#34;Scale a 2 repliques&#34;, codeHttp: response.status }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fScale</bpmn:incoming>
      <bpmn:outgoing>fb1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fb1" sourceRef="Scaler" targetRef="Tracer" />

    <!-- = Branche C (defaut) : redemarrage / rollback = -->
    <bpmn:serviceTask id="Redemarrer" name="5d. REDEMARRER (rollout restart)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;https://192.168.148.150:6443/apis/apps/v1/namespaces/&#34; + ns + &#34;/deployments/&#34; + cible" target="url" />
          <zeebe:input source="=25" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Authorization&#34;: &#34;Bearer {{secrets.K8S_TOKEN}}&#34;, &#34;Content-Type&#34;: &#34;application/strategic-merge-patch+json&#34; }" target="headers" />
          <zeebe:input source="={ spec: { template: { metadata: { annotations: { &#34;kubectl.kubernetes.io/restartedAt&#34;: string(now()) } } } } }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={ resultatExec: &#34;Rollout restart&#34;, codeHttp: response.status }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fRestart</bpmn:incoming>
      <bpmn:outgoing>fc1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fc1" sourceRef="Redemarrer" targetRef="Tracer" />

    <!-- =============== 8. TRACER LA DECISION SUR L'OBJET K8S =============== -->
    <bpmn:serviceTask id="Tracer" name="6. Tracer la decision IA sur le deploiement">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;https://192.168.148.150:6443/apis/apps/v1/namespaces/&#34; + ns + &#34;/deployments/&#34; + cible" target="url" />
          <zeebe:input source="=25" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Authorization&#34;: &#34;Bearer {{secrets.K8S_TOKEN}}&#34;, &#34;Content-Type&#34;: &#34;application/strategic-merge-patch+json&#34; }" target="headers" />
          <zeebe:input source="={ metadata: { annotations: { &#34;helios.camunda/aiAction&#34;: actionIA, &#34;helios.camunda/aiType&#34;: typeIA, &#34;helios.camunda/aiConfidence&#34;: string(confianceIA), &#34;helios.camunda/executedAt&#34;: string(now()), &#34;helios.camunda/result&#34;: resultatExec } } }" target="body" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>fa2</bpmn:incoming>
      <bpmn:incoming>fb1</bpmn:incoming>
      <bpmn:incoming>fc1</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f6" sourceRef="Tracer" targetRef="FinExec" />

    <bpmn:endEvent id="FinExec" name="Action IA executee par Camunda">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FinSain" name="Cluster sain">
      <bpmn:incoming>fSain</bpmn:incoming>
      <bpmn:incoming>fRien</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FinProtege" name="Namespace systeme : escalade humaine, AUCUNE action automatique">
      <bpmn:incoming>fProtege</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FinIncoherent" name="Diagnostic IA contredit par le cluster : escalade, AUCUNE action">
      <bpmn:incoming>fIncoherent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- = Branche VM : l'API Kubernetes ne sait pas relancer un kubelet. On passe par
         la passerelle SSH (127.0.0.1:8099 sur la VM de Camunda), qui execute la commande
         sur le noeud concerne et journalise tout. = -->
    <bpmn:serviceTask id="ActionNoeud" name="5e. RELANCER kubelet sur la VM (SSH)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://127.0.0.1:8099/exec" target="url" />
          <zeebe:input source="=60" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34;, &#34;X-Helios-Token&#34;: &#34;{{secrets.HELIOS_BRIDGE_TOKEN}}&#34; }" target="headers" />
          <zeebe:input source="={ host: replace(cible, &#34;k8s-&#34;, &#34;&#34;), command: &#34;echo kube | sudo -S -p '' systemctl restart kubelet &amp;&amp; sleep 3 &amp;&amp; systemctl is-active kubelet&#34; }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression"
            value="={ execNoeud: response.body.stdout, execCode: response.body.exitCode, execOk: response.body.ok, execCible: response.body.host }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fNoeud</bpmn:incoming>
      <bpmn:outgoing>fn1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fn1" sourceRef="ActionNoeud" targetRef="FinNoeud" />

    <bpmn:endEvent id="FinNoeud" name="Action systeme executee sur la VM par Camunda">
      <bpmn:incoming>fn1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="P1" bpmnElement="helios-camunda-full-cycle">
      <bpmndi:BPMNShape id="s1" bpmnElement="Timer"><dc:Bounds x="140" y="250" width="36" height="36" /></bpmndi:BPMNShape>
