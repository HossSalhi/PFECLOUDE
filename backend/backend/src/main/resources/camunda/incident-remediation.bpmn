<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_IncidentRemediation"
                  targetNamespace="http://orange.pfe/backend/camunda">
  <bpmn:message id="Message_ApprovalDecision" name="incident-approval-decision">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= workflowCorrelationKey" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:process id="incident-remediation" name="Incident remediation" isExecutable="true">
    <bpmn:startEvent id="StartEvent_IncidentCreated" name="Incident created">
      <bpmn:outgoing>Flow_Start_To_ApprovalRequired</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_ApprovalRequired" name="Approval required?">
      <bpmn:incoming>Flow_Start_To_ApprovalRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalRequired_True</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalRequired_False</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="Event_WaitForApproval" name="Wait for approval">
      <bpmn:incoming>Flow_ApprovalRequired_True</bpmn:incoming>
      <bpmn:incoming>Flow_ExecutionFailed_To_Approval</bpmn:incoming>
      <bpmn:incoming>Flow_VerificationFailed_To_Approval</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval_To_Decision</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ApprovalDecision" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Approval outcome">
      <bpmn:incoming>Flow_Approval_To_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalEscalated</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ExecuteRemediation" name="Execute remediation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="execute-remediation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalRequired_False</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_Execute_To_ExecutionDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ExecutionResult" name="Execution succeeded?">
      <bpmn:incoming>Flow_Execute_To_ExecutionDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ExecutionSucceeded</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExecutionFailed_To_Approval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="Event_VerificationDelay" name="Wait verification delay">
      <bpmn:incoming>Flow_ExecutionSucceeded</bpmn:incoming>
      <bpmn:outgoing>Flow_Delay_To_Verify</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= duration(verificationDelayIso)</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_VerifyRecovery" name="Verify recovery">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-remediation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Delay_To_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_To_RecoveryDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_RecoveryResult" name="Recovered?">
      <bpmn:incoming>Flow_Verify_To_RecoveryDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_RecoveryResolved</bpmn:outgoing>
      <bpmn:outgoing>Flow_VerificationFailed_To_Approval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Resolved" name="Resolved">
      <bpmn:incoming>Flow_RecoveryResolved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
      <bpmn:incoming>Flow_ApprovalRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Escalated" name="Escalated">
      <bpmn:incoming>Flow_ApprovalEscalated</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_To_ApprovalRequired"
                       sourceRef="StartEvent_IncidentCreated"
                       targetRef="Gateway_ApprovalRequired" />

    <bpmn:sequenceFlow id="Flow_ApprovalRequired_True"
                       sourceRef="Gateway_ApprovalRequired"
                       targetRef="Event_WaitForApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approvalRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ApprovalRequired_False"
                       sourceRef="Gateway_ApprovalRequired"
                       targetRef="Task_ExecuteRemediation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(approvalRequired)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Approval_To_Decision"
                       sourceRef="Event_WaitForApproval"
                       targetRef="Gateway_ApprovalDecision" />

    <bpmn:sequenceFlow id="Flow_ApprovalApproved"
                       sourceRef="Gateway_ApprovalDecision"
                       targetRef="Task_ExecuteRemediation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approvalDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ApprovalRejected"
                       sourceRef="Gateway_ApprovalDecision"
                       targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approvalDecision = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ApprovalEscalated"
                       sourceRef="Gateway_ApprovalDecision"
                       targetRef="EndEvent_Escalated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approvalDecision = "ESCALATED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Execute_To_ExecutionDecision"
                       sourceRef="Task_ExecuteRemediation"
                       targetRef="Gateway_ExecutionResult" />

    <bpmn:sequenceFlow id="Flow_ExecutionSucceeded"
                       sourceRef="Gateway_ExecutionResult"
                       targetRef="Event_VerificationDelay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= executionSucceeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ExecutionFailed_To_Approval"
                       sourceRef="Gateway_ExecutionResult"
                       targetRef="Event_WaitForApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(executionSucceeded)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Delay_To_Verify"
                       sourceRef="Event_VerificationDelay"
                       targetRef="Task_VerifyRecovery" />

    <bpmn:sequenceFlow id="Flow_Verify_To_RecoveryDecision"
                       sourceRef="Task_VerifyRecovery"
                       targetRef="Gateway_RecoveryResult" />

    <bpmn:sequenceFlow id="Flow_RecoveryResolved"
                       sourceRef="Gateway_RecoveryResult"
                       targetRef="EndEvent_Resolved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= recoveryResolved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_VerificationFailed_To_Approval"
                       sourceRef="Gateway_RecoveryResult"
                       targetRef="Event_WaitForApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(recoveryResolved)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
