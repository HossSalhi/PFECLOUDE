# kube-state-metrics externalise (sur la VM .160, hors cluster).
# A poser dans /etc/systemd/system/kube-state-metrics.service.
# Binaire /usr/local/bin/kube-state-metrics extrait de l'image registry.k8s.io/.../kube-state-metrics:v2.10.1.
# Le kubeconfig (jeton lecture-seule du SA kube-system/kube-state-metrics, secret ksm-external-token,
# serveur https://192.168.148.160:6443) est en /etc/helios/ksm.kubeconfig (NON versionne : contient un jeton).
# Prometheus scrape ensuite 127.0.0.1:8080.
[Unit]
Description=kube-state-metrics (externe - VM monitoring)
After=network-online.target

[Service]
ExecStart=/usr/local/bin/kube-state-metrics --kubeconfig=/etc/helios/ksm.kubeconfig --host=0.0.0.0 --port=8080 --telemetry-host=127.0.0.1 --telemetry-port=8081
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
